{
  "name": "hexa-frontier-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim:boss": "tsx sim/boss-check.ts",
    "sim:onboarding": "tsx sim/onboarding-check.ts",
    "sim:tune": "tsx sim/tune.ts",
    "sim:power": "tsx sim/power-calibrate.ts",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
